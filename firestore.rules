rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'demo-admin-uid'
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function validUser(id) {
      let data = request.resource.data;
      return data.keys().hasAll(['email', 'matkhau', 'hoten', 'hinhanh'])
        && data.keys().hasOnly(['email', 'matkhau', 'hoten', 'hinhanh'])
        && data.email is string && data.email == id && data.email.size() <= 254
        && data.email.matches('^[^/@ ]+@[^/@ ]+[.][^/@ ]+$')
        && data.hoten is string && data.hoten.size() > 0 && data.hoten.size() <= 100
        && data.matkhau is string && data.matkhau.matches('^[$]2b[$]12[$][./0-9A-Za-z]{53}$')
        && data.hinhanh is string && data.hinhanh.size() <= 220000
        && data.hinhanh.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+=*$');
    }

    match /nguoidung/{email} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && validUser(email);
    }
  }
}
